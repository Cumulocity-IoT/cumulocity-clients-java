<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nsn.cumulocity.clients-java</groupId>
    <artifactId>clients-java</artifactId>
    <packaging>pom</packaging>
    <version>${revision}${changelist}</version>
    <name>Cumulocity :: Clients Java</name>
    <url>http://startups.jira.com/wiki/display/MTM/Home</url>

    <distributionManagement>
        <snapshotRepository>
            <id>snapshot</id>
            <url>${nexus.url}${nexus.basePath}/snapshots</url>
        </snapshotRepository>
        <repository>
            <id>release</id>
            <url>${nexus.url}${nexus.basePath}/releases</url>
        </repository>
    </distributionManagement>

    <modules>
        <module>resource-bundle</module>
        <module>svenson</module>
        <module>device-capability-model</module>
        <module>java-client-model</module>
        <module>java-client</module>
        <module>java-email-client</module>
        <module>java-sms-client</module>
        <module>java-client-services</module>
        <module>java-mqtt-client</module>
        <module>mqtt-service</module>
    </modules>

    <properties>
        <revision>2025.54.0</revision>
        <changelist>-SNAPSHOT</changelist>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>17</java.version>
        <nexus.url>http://localhost:8080</nexus.url>
        <nexus.basePath>/nexus/content/repositories</nexus.basePath>

        <aspectj.version>1.9.24</aspectj.version> <!-- bound with spring-boot.version -->
        <cometd.version>3.0.10</cometd.version>
        <commons-beanutils.version>1.11.0</commons-beanutils.version>
        <commons-collections.version>3.2.2</commons-collections.version>
        <commons-io.version>2.19.0</commons-io.version>
        <guava.version>33.4.8-jre</guava.version>
        <httpclient.version>4.5.14</httpclient.version>
        <jaxrs-api.version>3.1.0</jaxrs-api.version>
        <jetty.version>11.0.24</jetty.version> <!-- bound with spring-boot.version -->
        <joda-time.version>2.10.14</joda-time.version>
        <jsr305-api.version>3.0.2</jsr305-api.version>
        <lombok.version>1.18.38</lombok.version> <!-- bound with spring-boot.version -->
        <microemu.version>2.0.4</microemu.version>
        <mock-server.version>5.15.0</mock-server.version>
        <spring-boot.version>3.4.6</spring-boot.version>
        <svenson.version>1.5.8</svenson.version>
        <tootallnate.websocket.version>1.6.0</tootallnate.websocket.version>

        <exclude.test.groups>com.cumulocity.test.category.IntegrationTest</exclude.test.groups>
    </properties>

